<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dynamixel_robot_arm">
  <xacro:arg name="device_name" default="/dev/ttyUSB0"/>
  <xacro:arg name="link1_length" default="0.25"/>
  <xacro:arg name="link2_length" default="0.20"/>
  <xacro:arg name="link3_length" default="0.15"/>
  <xacro:arg name="use_gripper" default="true"/>
  <xacro:arg name="degrees_per_tick" default="0.087890625"/>
  <xacro:arg name="joint1_motor_id" default="1"/>
  <xacro:arg name="joint1_expected_model" default="1001"/>
  <xacro:arg name="joint1_expected_operating_mode" default="3"/>
  <xacro:arg name="joint1_expected_drive_mode" default="0"/>
  <xacro:arg name="joint1_zero_ticks" default="2040"/>
  <xacro:arg name="joint1_direction" default="1.0"/>
  <xacro:arg name="joint1_min_absolute_deg" default="80.84"/>
  <xacro:arg name="joint1_max_absolute_deg" default="277.84"/>
  <xacro:arg name="joint2_motor_id" default="2"/>
  <xacro:arg name="joint2_expected_model" default="1001"/>
  <xacro:arg name="joint2_expected_operating_mode" default="3"/>
  <xacro:arg name="joint2_expected_drive_mode" default="0"/>
  <xacro:arg name="joint2_zero_ticks" default="2553"/>
  <xacro:arg name="joint2_direction" default="1.0"/>
  <xacro:arg name="joint2_min_absolute_deg" default="111.25"/>
  <xacro:arg name="joint2_max_absolute_deg" default="337.52"/>
  <xacro:arg name="joint3_motor_id" default="3"/>
  <xacro:arg name="joint3_expected_model" default="1020"/>
  <xacro:arg name="joint3_expected_operating_mode" default="3"/>
  <xacro:arg name="joint3_expected_drive_mode" default="0"/>
  <xacro:arg name="joint3_zero_ticks" default="2375"/>
  <xacro:arg name="joint3_direction" default="1.0"/>
  <xacro:arg name="joint3_min_absolute_deg" default="105.45"/>
  <xacro:arg name="joint3_max_absolute_deg" default="311.95"/>
  <xacro:arg name="gripper_joint_motor_id" default="4"/>
  <xacro:arg name="gripper_joint_expected_model" default="1020"/>
  <xacro:arg name="gripper_joint_expected_operating_mode" default="4"/>
  <xacro:arg name="gripper_joint_expected_drive_mode" default="0"/>
  <xacro:arg name="gripper_joint_zero_ticks" default="2305"/>
  <xacro:arg name="gripper_joint_direction" default="1.0"/>
  <xacro:arg name="gripper_joint_min_absolute_deg" default="320.80078125"/>
  <xacro:arg name="gripper_joint_max_absolute_deg" default="514.072265625"/>
  <xacro:property name="link1_length" value="$(arg link1_length)"/>
  <xacro:property name="link2_length" value="$(arg link2_length)"/>
  <xacro:property name="link3_length" value="$(arg link3_length)"/>
  <!-- Launch supplies these values from config/robot_arm_calibration.yaml. -->
  <xacro:property name="degrees_per_tick" value="$(arg degrees_per_tick)"/>
  <xacro:property name="radians_per_tick" value="${radians(float(degrees_per_tick))}"/>
  <xacro:property name="joint1_zero_deg"
    value="${int('$(arg joint1_zero_ticks)') * float(degrees_per_tick)}"/>
  <xacro:property name="joint2_zero_deg"
    value="${int('$(arg joint2_zero_ticks)') * float(degrees_per_tick)}"/>
  <xacro:property name="joint3_zero_deg"
    value="${int('$(arg joint3_zero_ticks)') * float(degrees_per_tick)}"/>
  <xacro:property name="gripper_zero_deg"
    value="${int('$(arg gripper_joint_zero_ticks)') * float(degrees_per_tick)}"/>
  <xacro:property name="joint1_a"
    value="${float('$(arg joint1_direction)') * (float('$(arg joint1_min_absolute_deg)') - joint1_zero_deg)}"/>
  <xacro:property name="joint1_b"
    value="${float('$(arg joint1_direction)') * (float('$(arg joint1_max_absolute_deg)') - joint1_zero_deg)}"/>
  <xacro:property name="joint2_a"
    value="${float('$(arg joint2_direction)') * (float('$(arg joint2_min_absolute_deg)') - joint2_zero_deg)}"/>
  <xacro:property name="joint2_b"
    value="${float('$(arg joint2_direction)') * (float('$(arg joint2_max_absolute_deg)') - joint2_zero_deg)}"/>
  <xacro:property name="joint3_a"
    value="${float('$(arg joint3_direction)') * (float('$(arg joint3_min_absolute_deg)') - joint3_zero_deg)}"/>
  <xacro:property name="joint3_b"
    value="${float('$(arg joint3_direction)') * (float('$(arg joint3_max_absolute_deg)') - joint3_zero_deg)}"/>
  <xacro:property name="gripper_a"
    value="${float('$(arg gripper_joint_direction)') * (float('$(arg gripper_joint_min_absolute_deg)') - gripper_zero_deg)}"/>
  <xacro:property name="gripper_b"
    value="${float('$(arg gripper_joint_direction)') * (float('$(arg gripper_joint_max_absolute_deg)') - gripper_zero_deg)}"/>
  <xacro:property name="joint1_min_rad" value="${radians(min(joint1_a, joint1_b))}"/>
  <xacro:property name="joint1_max_rad" value="${radians(max(joint1_a, joint1_b))}"/>
  <xacro:property name="joint2_min_rad" value="${radians(min(joint2_a, joint2_b))}"/>
  <xacro:property name="joint2_max_rad" value="${radians(max(joint2_a, joint2_b))}"/>
  <xacro:property name="joint3_min_rad" value="${radians(min(joint3_a, joint3_b))}"/>
  <xacro:property name="joint3_max_rad" value="${radians(max(joint3_a, joint3_b))}"/>
  <xacro:property name="gripper_min_rad" value="${radians(min(gripper_a, gripper_b))}"/>
  <xacro:property name="gripper_max_rad" value="${radians(max(gripper_a, gripper_b))}"/>

  <!-- Placeholder geometry: replace lengths and meshes with the actual mechanism. -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.10 0.10 0.05"/></geometry>
      <material name="base_gray"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="${float(link1_length) / 2.0} 0 0"/>
      <geometry><box size="${link1_length} 0.04 0.04"/></geometry>
      <material name="arm_blue"><color rgba="0.1 0.4 0.8 1"/></material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 0 1"/>
    <!-- Measured 78.84..279.84 deg; limits include a 2 deg safety margin. -->
    <limit lower="${joint1_min_rad}" upper="${joint1_max_rad}" velocity="1.0" effort="5.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="${float(link2_length) / 2.0} 0 0"/>
      <geometry><box size="${link2_length} 0.035 0.035"/></geometry>
      <material name="arm_orange"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="${link1_length} 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Measured 109.25..339.52 deg; limits include a 2 deg safety margin. -->
    <limit lower="${joint2_min_rad}" upper="${joint2_max_rad}" velocity="1.0" effort="5.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="${float(link3_length) / 2.0} 0 0"/>
      <geometry><box size="${link3_length} 0.03 0.03"/></geometry>
      <material name="arm_green"><color rgba="0.1 0.7 0.35 1"/></material>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="${link2_length} 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Measured 103.45..313.95 deg; limits include a 2 deg safety margin. -->
    <limit lower="${joint3_min_rad}" upper="${joint3_max_rad}" velocity="1.0" effort="5.0"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0.035 0 0"/>
      <geometry><box size="0.07 0.06 0.025"/></geometry>
      <material name="gripper_gray"><color rgba="0.4 0.4 0.4 1"/></material>
    </visual>
  </link>

  <xacro:if value="$(arg use_gripper)">
    <joint name="gripper_joint" type="revolute">
      <parent link="link3"/>
      <child link="gripper_link"/>
      <origin xyz="${link3_length} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${gripper_min_rad}" upper="${gripper_max_rad}" velocity="0.5" effort="5.0"/>
    </joint>
  </xacro:if>
  <xacro:unless value="$(arg use_gripper)">
    <joint name="gripper_fixed_joint" type="fixed">
      <parent link="link3"/>
      <child link="gripper_link"/>
      <origin xyz="${link3_length} 0 0"/>
    </joint>
  </xacro:unless>

  <ros2_control name="DynamixelRobotArm" type="system">
    <hardware>
      <plugin>robot_arm_hardware/DynamixelSystem</plugin>
      <param name="device_name">$(arg device_name)</param>
      <param name="baud_rate">1000000</param>
      <param name="protocol_version">2.0</param>
      <param name="drive_mode_address">10</param>
      <param name="operating_mode_address">11</param>
      <param name="torque_enable_address">64</param>
      <param name="goal_position_address">116</param>
      <param name="present_velocity_address">128</param>
      <param name="present_position_address">132</param>
      <param name="present_current_address">126</param>
      <param name="present_input_voltage_address">144</param>
      <param name="present_temperature_address">146</param>
      <param name="hardware_error_status_address">70</param>
      <param name="bus_watchdog_address">98</param>
      <param name="bus_watchdog_raw">25</param>
      <param name="diagnostic_read_interval">50</param>
      <param name="max_consecutive_read_failures">3</param>
      <param name="velocity_rad_s_per_raw_unit">0.023980824</param>
      <param name="current_amp_per_raw_unit">0.00269</param>
    </hardware>

    <joint name="joint1">
      <param name="motor_id">$(arg joint1_motor_id)</param>
      <param name="expected_model">$(arg joint1_expected_model)</param>
      <param name="expected_operating_mode">$(arg joint1_expected_operating_mode)</param>
      <param name="expected_drive_mode">$(arg joint1_expected_drive_mode)</param>
      <param name="zero_ticks">$(arg joint1_zero_ticks)</param>
      <param name="direction">$(arg joint1_direction)</param>
      <param name="radians_per_tick">${radians_per_tick}</param>
      <command_interface name="position">
        <param name="min">${joint1_min_rad}</param><param name="max">${joint1_max_rad}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="hardware_error"/>
      <state_interface name="bus_watchdog"/>
      <state_interface name="communication_ok"/>
    </joint>

    <joint name="joint2">
      <param name="motor_id">$(arg joint2_motor_id)</param>
      <param name="expected_model">$(arg joint2_expected_model)</param>
      <param name="expected_operating_mode">$(arg joint2_expected_operating_mode)</param>
      <param name="expected_drive_mode">$(arg joint2_expected_drive_mode)</param>
      <param name="zero_ticks">$(arg joint2_zero_ticks)</param>
      <param name="direction">$(arg joint2_direction)</param>
      <param name="radians_per_tick">${radians_per_tick}</param>
      <command_interface name="position">
        <param name="min">${joint2_min_rad}</param><param name="max">${joint2_max_rad}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="hardware_error"/>
      <state_interface name="bus_watchdog"/>
      <state_interface name="communication_ok"/>
    </joint>

    <joint name="joint3">
      <param name="motor_id">$(arg joint3_motor_id)</param>
      <param name="expected_model">$(arg joint3_expected_model)</param>
      <param name="expected_operating_mode">$(arg joint3_expected_operating_mode)</param>
      <param name="expected_drive_mode">$(arg joint3_expected_drive_mode)</param>
      <param name="zero_ticks">$(arg joint3_zero_ticks)</param>
      <param name="direction">$(arg joint3_direction)</param>
      <param name="radians_per_tick">${radians_per_tick}</param>
      <command_interface name="position">
        <param name="min">${joint3_min_rad}</param><param name="max">${joint3_max_rad}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="hardware_error"/>
      <state_interface name="bus_watchdog"/>
      <state_interface name="communication_ok"/>
    </joint>

    <xacro:if value="$(arg use_gripper)">
      <joint name="gripper_joint">
        <param name="motor_id">$(arg gripper_joint_motor_id)</param>
        <param name="expected_model">$(arg gripper_joint_expected_model)</param>
        <param name="expected_operating_mode">$(arg gripper_joint_expected_operating_mode)</param>
        <param name="expected_drive_mode">$(arg gripper_joint_expected_drive_mode)</param>
        <param name="zero_ticks">$(arg gripper_joint_zero_ticks)</param>
        <param name="direction">$(arg gripper_joint_direction)</param>
        <param name="radians_per_tick">${radians_per_tick}</param>
        <command_interface name="position">
          <param name="min">${gripper_min_rad}</param><param name="max">${gripper_max_rad}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="current"/>
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="hardware_error"/>
        <state_interface name="bus_watchdog"/>
        <state_interface name="communication_ok"/>
      </joint>
    </xacro:if>
  </ros2_control>
</robot>
